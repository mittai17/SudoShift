# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_PROJECT_ID: Your Supabase project ref.
SUPABASE_PROJECT_ID="MY_SUPABASE_PROJECT_ID"

# VITE_SUPABASE_URL: Public Supabase project URL used by the browser client.
VITE_SUPABASE_URL="https://MY_SUPABASE_PROJECT_ID.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anon/publishable key for browser-side Supabase calls.
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# NEXT_PUBLIC_SUPABASE_*: Optional aliases for Next.js-compatible tooling.
NEXT_PUBLIC_SUPABASE_URL="https://MY_SUPABASE_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# VITE_AI_DUMP_GEMINI_KEY: Required for the Workflow Architect AI feature.
# Get your key at https://aistudio.google.com/app/apikey
VITE_AI_DUMP_GEMINI_KEY="MY_GEMINI_API_KEY"

# REDIS_URL: Optional. Enables Socket.IO multi-instance collaboration fan-out.
REDIS_URL="redis://localhost:6379"
